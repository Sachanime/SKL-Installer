{
  "name": "skl-installer",
  "version": "1.1.1",
  "description": "An installer for all SKL Programs",
  "homepage": "https://github.com/Sachanime/SKL-Installer#readme",
  "bugs": {
    "url": "https://github.com/Sachanime/SKL-Installer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sachanime/SKL-Installer.git"
  },
  "license": "",
  "author": "Sachanime",
  "type": "commonjs",
  "main": "index.js",
  "bin": "index.js",
  "pkg": {
    "assets": ["ASCII Art/**/*",
    "node_modules/regedit/vbs/**/*",
    "config.json"],
    "targets": ["node18-win-x64"]
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "pkg . --targets node18-win-x64 --output app.exe"
  },
  "dependencies": {
    "regedit": "^5.1.4"
  }
}
